# qico.service — outbound queue / originate daemon
#
# Part of qico.target (enable/start the target, not this unit alone).
# Uses foreground mode (-f) so systemd tracks the main process (Type=simple).
#
# Paths match production node 2:203/910:
#   binary: /home/map/ftn/usr/bin/qico
#   config: /home/map/ftn/usr/etc/qico/qico.conf
#   spool:  /home/map/ftn/fido

[Unit]
Description=qico FTN mailer daemon (originate / queue)
Documentation=man:qico(8)
PartOf=qico.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=map
Group=map

# Ensure runtime dirs exist (harmless if already present)
ExecStartPre=/bin/mkdir -p /home/map/ftn/fido/logs /home/map/ftn/fido/outbound /home/map/ftn/fido/inbound /home/map/ftn/fido/nodelist

# Fail early if config is broken
ExecStartPre=/home/map/ftn/usr/bin/qico -I/home/map/ftn/usr/etc/qico/qico.conf -t

# Foreground daemon (originate / queue manager). Visible to systemd; no double-fork.
ExecStart=/home/map/ftn/usr/bin/qico -I/home/map/ftn/usr/etc/qico/qico.conf -f

# SIGHUP reloads config (same idea as qctl -R)
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5

# Soft stop first; escalate if needed
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

WorkingDirectory=/home/map/ftn/fido

# Hardening (safe subset; relax if something breaks on your host)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=qico.target
